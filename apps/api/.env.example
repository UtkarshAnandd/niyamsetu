# Copy to .env and adjust. Every variable the API reads is listed here.

# PostgreSQL connection (read by Prisma). npm test derives niyamsetu_test from it.
DATABASE_URL="postgresql://postgres:dev@localhost:5432/niyamsetu"

# Secret for signing login tokens (JWT, valid 8 hours). The API refuses to start without it.
JWT_SECRET="change-me"

# Port the API listens on (default 4000).
PORT=4000

# true = deadlines in minutes instead of days (10-minute due dates, 3-minute due-soon
# window, 2-minute escalation grace). false = 7 days / 2 days / 1 day.
DEMO_MODE=true

# true = do not start the every-minute deadline cron job (POST /api/admin/run-deadline-check
# still works). Unset or false = cron runs.
DISABLE_CRON=false

# Not set here: TEST_PORT is set internally by `npm test` (port 4100).
